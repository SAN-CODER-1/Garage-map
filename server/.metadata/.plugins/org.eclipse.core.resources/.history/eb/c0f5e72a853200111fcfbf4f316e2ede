package com.wheelconnect.controller;

import org.springframework.http.ResponseEntity;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.web.bind.annotation.*;

import com.wheelconnect.Security.JwtUtil;
import com.wheelconnect.dto.LoginRequest;
import com.wheelconnect.dto.RegisterRequest;
import com.wheelconnect.entity.UserEntity;
import com.wheelconnect.repositories.userrepo;

import jakarta.servlet.http.Cookie;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

import java.util.Map;

@RestController
@RequestMapping("/auth")
@CrossOrigin(origins = "http://localhost:8081", allowCredentials = "true")
public class AuthController {

    private final JwtUtil jwtUtil;
    private final userrepo userrepo;
    private final PasswordEncoder passwordEncoder;

    public AuthController(JwtUtil jwtUtil,
                          userrepo userrepo,
                          PasswordEncoder passwordEncoder) {
        this.jwtUtil = jwtUtil;
        this.userrepo = userrepo;
        this.passwordEncoder = passwordEncoder;
    }

    @PostMapping("/register/user")
    public ResponseEntity<UserEntity> registerUser(
            @RequestBody RegisterRequest request,
            HttpServletResponse response) {

        if (userrepo.existsByEmail(request.getEmail())) {
            throw new RuntimeException("Email already registered");
        }

        UserEntity user = new UserEntity();
        user.setUsername(request.getUsername());
        user.setEmail(request.getEmail());
        user.setPhoneNumber(request.getPhoneNumber());
        user.setPasswordHash(passwordEncoder.encode(request.getPassword()));
        user.setRole(UserEntity.Role.USER);

        UserEntity savedUser = userrepo.save(user);

        String token = jwtUtil.generateToken(
                savedUser.getEmail(),
                savedUser.getRole().name()
        );

        setCookie(response, token);

        return ResponseEntity.ok(savedUser);
    }

    @PostMapping("/register/garage")
    public ResponseEntity<UserEntity> registerGarageOwner(
            @RequestBody RegisterRequest request,
            HttpServletResponse response) {

        if (userrepo.existsByEmail(request.getEmail())) {
            throw new RuntimeException("Email already registered");
        }

        UserEntity owner = new UserEntity();
        owner.setUsername(request.getUsername());
        owner.setEmail(request.getEmail());
        owner.setPhoneNumber(request.getPhoneNumber());
        owner.setPasswordHash(passwordEncoder.encode(request.getPassword()));
        owner.setRole(UserEntity.Role.GARAGE_OWNER);
        owner.setGarageName(request.getGarageName());
        owner.setGarageAddress(request.getGarageAddress());

        UserEntity savedOwner = userrepo.save(owner);

        String token = jwtUtil.generateToken(
                savedOwner.getEmail(),
                savedOwner.getRole().name()
        );

        setCookie(response, token);

        return ResponseEntity.ok(savedOwner);
    }

    @PostMapping("/login")
    public ResponseEntity<UserEntity> login(
            @RequestBody LoginRequest request,
            HttpServletResponse response) {

        UserEntity user = userrepo.findByEmail(request.getEmail())
                .orElseThrow(() -> new RuntimeException("User not found"));

        if (!passwordEncoder.matches(
                request.getPassword(),
                user.getPasswordHash())) {
            throw new RuntimeException("Invalid password");
        }
        
        String token = jwtUtil.generateToken(
                user.getEmail(),
                user.getRole().name()
        );

        setCookie(response, token);

        return ResponseEntity.ok(user);
    }

    // ✅ VALIDATE API (used by frontend)
    @GetMapping("/validate")
    public ResponseEntity<?> validate(HttpServletRequest request) {

        Cookie[] cookies = request.getCookies();
        if (cookies == null) return ResponseEntity.status(401).build();

        for (Cookie cookie : cookies) {
            if (cookie.getName().equals("wheelconnect_token")) {

                String token = cookie.getValue();
                String email = jwtUtil.extractUsername(token);
                String role = jwtUtil.extractRole(token);

                return ResponseEntity.ok(
                        Map.of("email", email, "role", role)
                );
            }
        }

        return ResponseEntity.status(401).build();
    }

    private void setCookie(HttpServletResponse response, String token) {
        Cookie cookie = new Cookie("wheelconnect_token", token);
        cookie.setHttpOnly(true);
        cookie.setPath("/");
        cookie.setMaxAge(60 * 60 * 24);
        response.addCookie(cookie);
    }
}