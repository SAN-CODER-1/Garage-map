package com.wheelconnect.controller;

import org.springframework.http.ResponseEntity;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.web.bind.annotation.*;

import com.wheelconnect.Security.JwtUtil;
import com.wheelconnect.dto.LoginRequest;
import com.wheelconnect.entity.UserEntity;
import com.wheelconnect.repositories.userrepo;

import jakarta.servlet.http.Cookie;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@RestController
@RequestMapping("/auth")
@CrossOrigin(origins = "http://localhost:8081", allowCredentials = "true")
public class AuthController {

    private final JwtUtil jwtUtil;
    private final userrepo userrepo;
    private final PasswordEncoder passwordEncoder;

    public AuthController(JwtUtil jwtUtil,
                          userrepo userrepo,
                          PasswordEncoder passwordEncoder) {
        this.jwtUtil = jwtUtil;
        this.userrepo = userrepo;
        this.passwordEncoder = passwordEncoder;
    }

    // LOGIN
    @PostMapping("/login")
    public ResponseEntity<UserEntity> login(
            @RequestBody LoginRequest request,
            HttpServletResponse response) {

        UserEntity user = userrepo
                .findByEmail(request.getEmail())
                .orElseThrow(() -> new RuntimeException("User not found"));

        if (!passwordEncoder.matches(
                request.getPassword(),
                user.getPasswordHash())) {

            throw new RuntimeException("Invalid password");
        }

        String token = jwtUtil.generateToken(user.getEmail());

        Cookie cookie = new Cookie("wheelconnect_token", token);
        cookie.setHttpOnly(true);
        cookie.setPath("/");
        cookie.setMaxAge(60 * 60 * 24);

        response.addCookie(cookie);

        return ResponseEntity.ok(user);
    }

    // GET CURRENT USER
    @GetMapping("/users/me")
    public ResponseEntity<UserEntity> currentUser(
            HttpServletRequest request) {

        Cookie[] cookies = request.getCookies();

        if (cookies == null) {
            return ResponseEntity.status(401).build();
        }

        for (Cookie cookie : cookies) {

            if (cookie.getName().equals("wheelconnect_token")) {

                String token = cookie.getValue();

                String email = jwtUtil.extractUsername(token);

                UserEntity user =
                        userrepo.findByEmail(email).orElseThrow();

                return ResponseEntity.ok(user);
            }
        }

        return ResponseEntity.status(401).build();
    }
}